\newlabel{fig:pipeline}{{1}{38}{The 25-step GNN processing pipeline as a directed acyclic graph, arranged in rowwise topological order and colored by execution phase (legend above the nodes). Each node is the thin step orchestrator under \protect \texttt {src/gnn/} named in tbl.~\ref {tbl:pipeline_steps}; each arrow is a required orchestration prerequisite parsed from the Data Dependency Graph block of \protect \breaktt {src/gnn/STEP\_INDEX.md}, which mirrors the live step registry. Parsing (Step 3) precedes many later steps. Optional artifact enrichments are documented separately and are not shown as required edges. The figure is generated from \protect \breaktt {src/gnn/STEP\_INDEX.md} at commit a57e17d86; its footer restates the step count, the number of required prerequisites, and the layout rule}{fig:pipeline}{}}
\@writefile{snm}{\beamer@slide {fig:pipeline}{38}}
\@writefile{nav}{\headcommand {\slideentry {1}{3}{3}{38/38}{The Processing Pipeline}{0}}}
\@writefile{nav}{\headcommand {\beamer@framepages {38}{38}}}
\HyPL@Entry{38<</P(\376\377\0003\0009)>>}
