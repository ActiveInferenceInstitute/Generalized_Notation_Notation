\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Render targets declared in \breaktt {src/gnn/render/framework\_registry.py}, one row per registry key in registry order. The \emph  {Executes} column is the registry's own \breaktt {supports\_execution} flag: 12 of 12 backends have a Step-12 executor, and a \texttt {render-only} entry would mean generated code with no Step-12 executor. Read this table against tbl.~\ref {tbl:model_families}, which shows which families actually target each backend.}}{13}{table.3}\protected@file@percent }
\newlabel{tbl:backend_registry}{{3}{13}{Render targets declared in \protect \breaktt {src/gnn/render/framework\_registry.py}, one row per registry key in registry order. The \emph {Executes} column is the registry's own \protect \breaktt {supports\_execution} flag: 12 of 12 backends have a Step-12 executor, and a \protect \texttt {render-only} entry would mean generated code with no Step-12 executor. Read this table against tbl.~\ref {tbl:model_families}, which shows which families actually target each backend}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Model kinds each render framework supports, read entirely from the flags in \breaktt {src/gnn/render/framework\_registry.py} --- the same source as tbl.~\ref {tbl:backend_registry}. A continuous cell of \texttt {unsupported} is the renderer's own status for continuous-state models; continuous-only targets do not render categorical models. An executor entry declares dispatch support, not acceptance of every model or inference mode; a render-only entry has no Step-12 executor. Read with tbl.~\ref {tbl:model_kinds}, which groups the same flags by model kind.}}{13}{table.4}\protected@file@percent }
\newlabel{tbl:framework_capability}{{4}{13}{Model kinds each render framework supports, read entirely from the flags in \protect \breaktt {src/gnn/render/framework\_registry.py} --- the same source as tbl.~\ref {tbl:backend_registry}. A continuous cell of \protect \texttt {unsupported} is the renderer's own status for continuous-state models; continuous-only targets do not render categorical models. An executor entry declares dispatch support, not acceptance of every model or inference mode; a render-only entry has no Step-12 executor. Read with tbl.~\ref {tbl:model_kinds}, which groups the same flags by model kind}{table.4}{}}
