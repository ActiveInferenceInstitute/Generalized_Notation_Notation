# ============================================================================
# PIPELINE OUTPUTS
# ============================================================================
# Root output/ follows the curated-vs-volatile boundary above (see
# docs/development/output_tracking.md). The patterns below cover historical
# nested scratch directories in case output paths are redirected under tracked
# folders.

# Ignore temporary and intermediate files
output/*/temp/
output/*/tmp/
output/*/cache/
output/*/*_temp_*
output/*/*_tmp_*

# Debug and development outputs
output/*/debug/
output/*/dev/

# ============================================================================
# LOGS AND DEBUGGING
# ============================================================================
# Log files
*.log
logs/
log/
*.log.*

# Exception: the manuscript's LaTeX log is evidence, not scratch.
# src/tests/test_manuscript_latex_log.py pins the diagnostics the shipped PDF
# carries, and every sibling artifact from the same render (.aux/.bbl/.blg/.toc/
# .tex) is already tracked under the "Keep it committed!" policy above. Tracking
# it is what lets that test fail explicitly on a clean checkout instead of
# skipping, which the zero-skip contract forbids.
!output/pdf/_combined_manuscript.log

# Debug files
debug/
debug_*
*_debug.*

# Profiling outputs
*.prof
*.pstat
profiling/

