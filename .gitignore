# To clean ignored files: git clean -fdx
# To see what would be cleaned: git clean -fdxn
# To update this file: Review and test patterns before committing
#
# Last updated: March 23, 2026
# ============================================================================
/.desloppify
/.claude
/.desloppify
/src/.desloppify

