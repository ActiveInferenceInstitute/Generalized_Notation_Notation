# ============================================================================
# Generalized Notation Notation (GNN) - Git Ignore Configuration
# ============================================================================
# This file contains comprehensive ignore patterns for the GNN project
# including Python, scientific computing, and pipeline-specific artifacts
# ============================================================================

# ============================================================================
# PYTHON VIRTUAL ENVIRONMENTS
# ============================================================================
/src/.venv
.venv/
venv/
env/
ENV/
.pytest_cache/
src/.pytest_cache/
*/.pytest_cache/
*.pytest_cache/

# ============================================================================
# ENVIRONMENT AND CONFIGURATION FILES
# ============================================================================
# Environment variables (NEVER commit these!)
.env
.env*
*.env
.env.local
.env.production
.env.development
# Ship only the tracked placeholder template; real environment files stay ignored.
!/src/gnn/llm/.env.example

# Configuration files with secrets
config.local.json
config.local.yaml
secrets.json
secrets.yaml
credentials.json

# ============================================================================
# PYTHON ARTIFACTS
# ============================================================================
# Python bytecode and cache (never `git add` these; if tracked historically, `git rm -r --cached **/__pycache__`)
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
# Negate scripts/lib/ so shared utilities are tracked
!scripts/lib/
!/scripts/lib/*
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Specific module cache directories
/src/export/__pycache__/
/src/setup/__pycache__/
/src/utils/__pycache__/
/src/*/activeinference_jl/.julia
/src/execute/activeinference_jl/.julia

# ============================================================================
# GENERATED ARTIFACT TREES (NOT MAINTAINED SOURCE)
# ============================================================================
# Root pipeline output/ follows a curated-vs-volatile tracking boundary —
# decision note: docs/development/output_tracking.md.
#
# CURATED published artifacts stay TRACKED (not ignored; manuscript gates read them):
#   output/manuscript/  manuscript sections + config
#   output/pdf/         combined manuscript PDF + LaTeX evidence (.aux/.bbl/.log/.toc/...)
#   output/figures/     figure_registry.json + the PNGs it references
#   output/data/        manuscript_variables.json (manuscript variable gate input)
#   output/slides/      beamer slide bundles (FLAGGED: no in-repo writer found; kept tracked)
#   output/web/         manuscript HTML site (FLAGGED: no in-repo writer found; kept tracked)
#   output/reports/     manuscript_composition.json (FLAGGED: no in-repo writer found; kept tracked)
#
# VOLATILE step/run outputs are regenerated on every pipeline run — ignored here
# and untracked from the index, so a full-suite run never dirties `git status`:
output/[0-9]*_*_output/
output/00_pipeline_summary/
output/00_pipeline_logs/
output/PIPELINE_REPORT.md
output/semantic_fidelity/
output/cross_framework/
output/model_family_acceptance/
output/v3_run_manifest/
output/.gnn_run.lock
/out/

# Historical or redirected pipeline output under src/ may be generated as well, but should be ignored.
/src/output/*

# Contract-test scratch written by tests/api/test_api_endpoints.py
output/api_contract_test/
output/job_contract_test/
output/api_pull_test/

# Timestamped or run-specific documentation execution outputs are regenerated
# from examples; curated docs and source examples remain tracked outside these
# generated directories.
doc/**/activeinference_outputs_*/
doc/**/pomdp_gridworld_outputs/
doc/**/*_outputs_*/
doc/**/test_output/

# Optional fixture copies under tests are generated scratch unless explicitly
# moved into a documented fixture directory.
src/tests/output/

